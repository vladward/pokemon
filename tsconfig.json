{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "sourceMap": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["src/*"],
      "@i18n/*": ["i18n/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "resolveJsonModule": true
  },
  "include": ["next-env.d.ts", "src", "i18n", ".next/types/**/*.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

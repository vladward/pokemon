model pokemon_held_item {
  pokemon_id Int
  item_id    Int
  version_id Int
  rarity     Int?
  pokemon    pokemon @relation(fields: [pokemon_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pokemon_held_item_ibfk_1")
  item       item    @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pokemon_held_item_ibfk_2")
  version    version @relation(fields: [version_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pokemon_held_item_ibfk_3")

  @@id([pokemon_id, item_id, version_id])
  @@index([item_id], map: "item_id")
  @@index([version_id], map: "version_id")
}

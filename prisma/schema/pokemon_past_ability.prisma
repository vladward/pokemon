model pokemon_past_ability {
  id            Int      @id @default(autoincrement())
  pokemon_id    Int
  generation_id Int
  slot          Int
  ability_id    Int
  is_hidden     Boolean?
  pokemon       pokemon  @relation(fields: [pokemon_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pokemon_past_ability_ibfk_1")
  ability       ability  @relation(fields: [ability_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pokemon_past_ability_ibfk_2")

  @@unique([pokemon_id, generation_id, slot], map: "uq_pokemon_past_ability")
  @@index([ability_id], map: "ability_id")
}

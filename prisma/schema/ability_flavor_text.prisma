model ability_flavor_text {
  ability_id       Int
  language         String        @db.VarChar(10)
  version_group_id Int
  flavor_text      String        @db.Text
  ability          ability       @relation(fields: [ability_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ability_flavor_text_ibfk_1")
  version_group    version_group @relation(fields: [version_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ability_flavor_text_ibfk_2")

  @@id([ability_id, language, version_group_id])
  @@index([version_group_id], map: "ability_flavor_text_ibfk_2")
}

{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/shared/ui/shadcn",
    "utils": "@/shared/lib/utils",
    "ui": "@/shared/ui/shadcn",
    "lib": "@/shared/lib",
    "hooks": "@/shared/lib/hooks"
  },
  "registries": {
    "@reui": "https://reui.io/r/{style}/{name}.json"
  }
}

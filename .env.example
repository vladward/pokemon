# ── Database ─────────────────────────────────────────────────────────────────
# Switch active DB: npm run db:use:docker | npm run db:use:tidb

DATABASE_URL_DOCKER="mysql://root:root@localhost:3306/pokemon"
DATABASE_URL_TIDB="mysql://<user>:<password>@<host>:<port>/<database>?sslaccept=strict"

# Active connection — Prisma
DATABASE_URL="mysql://root:root@localhost:3306/pokemon"

# Active connection — mysql2 (seeds, scripts)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pokemon

# ── App ──────────────────────────────────────────────────────────────────────
BASE_URL="http://localhost:3000"
PORT=3000

# ── Playwright ───────────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSERS_PATH=

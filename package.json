{
  "name": "pokemon_repo",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build",
    "db:migrate": "tsx scripts/run-migrate.ts",
    "db:setup:docker": "tsx scripts/setup-docker.ts",
    "db:sync": "tsx scripts/sync-db.ts",
    "db:use:docker": "tsx scripts/switch-db.ts docker",
    "db:use:tidb": "tsx scripts/switch-db.ts tidb",
    "dev": "next dev",
    "fix": "prettier --write .",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "lint": "next lint",
    "seed:abilities": "tsx scripts/run-seed-abilities.ts",
    "seed:all": "npm run db:migrate && npm run seed:version-groups && npm run seed:types && npm run seed:stats && npm run seed:growth-rates && npm run seed:egg-groups && npm run seed:natures && npm run seed:encounter-methods && npm run seed:item-categories && npm run seed:item-attributes && npm run seed:items && npm run seed:berries && npm run seed:moves && npm run seed:abilities && npm run seed:machines && npm run seed:pokemon && npm run seed:forms && npm run seed:characteristics && npm run seed:generations && npm run seed:regions && npm run seed:versions && npm run seed:pokedex && npm run seed:locations",
    "seed:pokemon-form-names-export": "tsx scripts/run-export-pokemon-form-names-en.ts",
    "seed:pokemon-names-export": "tsx scripts/run-export-pokemon-names-en.ts",
    "seed:pokemon-names-translate": "tsx scripts/run-seed-pokemon-names-translate.ts",
    "seed:regions": "tsx scripts/run-seed-regions.ts",
    "seed:reset": "tsx scripts/run-reset.ts",
    "seed:sprites": "tsx scripts/run-sprites.ts",
    "seed:stats": "tsx scripts/run-seed-stats.ts",
    "seed:types": "tsx scripts/run-seed-types.ts",
    "seed:version-groups": "tsx scripts/run-seed-version-groups.ts",
    "seed:versions": "tsx scripts/run-seed-versions.ts",
    "start": "next start",
    "test": "jest",
    "translate:pokemon-detail-ru": "tsx scripts/translate-pokemon-detail-ru/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@vitalets/google-translate-api": "^9.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "mysql2": "^3.22.4",
    "next": "^15.1.0",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.5.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "p-limit": "^7.3.0",
    "postcss": "^8.5.3",
    "prettier": "^3.3.0",
    "prettier-plugin-pkg": "^0.21.2",
    "prisma": "^6.19.3",
    "shadcn": "^4.9.0",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
